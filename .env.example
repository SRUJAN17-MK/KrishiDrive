# ─── KrishiDrive v2.1.0 — Environment Variables ───────────────────────────────

# ── Backend ─────────────────────────────────────────────────────────────────
PORT=8000

# REQUIRED: Generate a strong random secret (e.g., openssl rand -hex 64)
# The server will refuse to start in production if this is the placeholder.
JWT_SECRET=your-strong-random-secret-here

# Node environment (development | production)
NODE_ENV=development

# Optional: Custom data directory (defaults to backend/data/)
# DATA_DIR=/var/data/krishidrive

# Optional: Custom uploads directory (defaults to backend/uploads/)
# UPLOADS_DIR=/var/data/krishidrive/uploads

# Optional: Restrict CORS to your frontend origin in production
# FRONTEND_ORIGIN=https://yourapp.example.com

# Optional: Seed demo accounts into an empty database (development only)
# Set to "1" to enable; leave unset or "0" to disable in production
# SEED_DEMO_DATA=1

# ── OpenWeatherMap (Phase 3C: Real weather data) ─────────────────────────────
# Register free at: https://home.openweathermap.org/users/sign_up
# Free tier: 1,000 calls/day — sufficient for development
# OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# ── OSRM Routing (Phase 3A: Real road distances) ──────────────────────────────
# Default uses the public OSRM demo server (rate-limited, not for production).
# For production: self-host OSRM (https://github.com/Project-OSRM/osrm-backend)
# or use a hosted service.
# OSRM_BASE_URL=https://router.project-osrm.org

# ── Agmarknet / data.gov.in (Phase 3B: Live mandi prices) ────────────────────
# Register at: https://data.gov.in/
# Request API access to the Agmarknet commodity price dataset.
# AGMARKNET_API_KEY=your_data_gov_in_api_key_here

# ── SQLite Database ───────────────────────────────────────────────────────────
# Optional: Custom database file path (defaults to backend/data/krishidrive.db)
# DB_PATH=/var/data/krishidrive/krishidrive.db

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
