# KrishiDrive — .gitignore

# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
**/node_modules/

# ── Build outputs ─────────────────────────────────────────────────────────────
dist/
build/
.vite/

# ── Environment & secrets ─────────────────────────────────────────────────────
.env
.env.local
.env.production
.env.*.local
backend/.env
frontend/.env

# ── Database files ────────────────────────────────────────────────────────────
# SQLite databases contain user data — do not commit them
backend/data/*.db
backend/data/*.db-shm
backend/data/*.db-wal
backend/data/*.tmp
# JSON data files also contain user data (hashed passwords, phone numbers)
backend/data/users.json
backend/data/crops.json
backend/data/transport_requests.json
backend/data/trips.json
backend/data/vehicles.json
# JSON backups from migration
backend/data/json_backup/

# ── Uploads ───────────────────────────────────────────────────────────────────
backend/uploads/

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── OS generated ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editor ───────────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo

# ── Test artifacts ────────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ── Docker ────────────────────────────────────────────────────────────────────
.dockerignore
